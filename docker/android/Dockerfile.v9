# Per-container ADB port image: same as androidworld:v8 but with entrypoint and env.py
# that support ADB_SERVER_PORT for host networking + parallel creation.
# Build: docker build -f docker/android/Dockerfile.v9 -t androidworld:v9 docker/android
# Requires base image androidworld:v8 to exist.

FROM androidworld:v8

WORKDIR /data/RL4AndroidWorld

# Override entrypoint and server env with per-container ADB port support
COPY entrypoint.sh ./
COPY server/env.py server/

ENTRYPOINT ["bash", "./entrypoint.sh"]
