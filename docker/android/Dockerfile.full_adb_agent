# Unified image: per-container ADB port (host networking) + /step_adb endpoint
# + ui_elements in all observations.
#
# Supports all 4 agent modes:
#   - GUI action  + screenshot only
#   - GUI action  + screenshot + a11y tree
#   - ADB command + screenshot only
#   - ADB command + screenshot + a11y tree
#
# Build:
#   docker build -f docker/android/Dockerfile.full_adb_agent \
#       -t androidworld:full_adb_agent docker/android
#
# Requires base image androidworld:v8.

FROM androidworld:v8

WORKDIR /data/RL4AndroidWorld

# Patched env.py: per-container ADB_SERVER_PORT + ui_elements in observations
COPY server/env.py server/

# Unified server.py: /health, /reset, /step, /step_adb all in one process
COPY server/server.py server/

# Entrypoint with per-container ADB port support
COPY entrypoint.sh ./

ENTRYPOINT ["bash", "./entrypoint.sh"]
