    "version": "1.0",
    "model_name": "oracle",
    "tool_definitions": [
      {
        "type": "function",
        "function": {
          "name": "Bash",
          "description": "Execute CLI command: adb shell (device), sql (database), http (backend), read-file, write-file, find-files",
          "parameters": {
            "type": "object",
            "properties": {
              "command": {
                "type": "string"
              }
            },
            "required": [
              "command"
            ]
          }
        }
      }
    ]
  },
  "steps": [
    {
      "step_id": 1,
      "source": "system",
      "message": "[GroundTruth Discovery, MobileWorld]"
    },
    {
      "step_id": 2,
      "source": "user",
      "message": "I'm running out of space, can you check my files and delete zip files that are older than 1 year in my Download folder. Send myself on mattermost the list of deleted files just for record"
    },
    {
      "step_id": 3,
      "source": "agent",
      "message": "Find zip files older than 1 year in Download",
      "model_name": "oracle",
      "tool_calls": [
        {
          "tool_call_id": "call_3",
          "function_name": "Bash",
          "arguments": {
            "command": "adb shell \"for f in /sdcard/Download/*.zip; do ts=$(stat -c %Y $f); now=$(date +%s); [ $((now-ts)) -gt 31536000 ] && echo $(basename $f); done\""
          }
        }
      ],
      "observation": {
        "results": [
          {
            "source_call_id": "call_3",
            "content": "(list of old zip filenames)"
          }
        ]
      }
    },
    {
      "step_id": 4,
      "source": "agent",
      "message": "Delete each old zip file",
      "model_name": "oracle",
      "tool_calls": [
        {
          "tool_call_id": "call_4",
          "function_name": "Bash",
          "arguments": {
            "command": "adb shell \"rm /sdcard/Download/<old_file1>.zip /sdcard/Download/<old_file2>.zip ...\""
          }
        }
      ],
      "observation": {
        "results": [
          {
            "source_call_id": "call_4",
            "content": ""
          }
        ]
      }
    },
    {
      "step_id": 5,
      "source": "agent",
      "message": "Find own user ID on Mattermost",
      "model_name": "oracle",
      "tool_calls": [
        {
          "tool_call_id": "call_5",
          "function_name": "Bash",
          "arguments": {
            "command": "http POST psql://mattermost:5433 --headers \"Content-Type: application/sql\" --data \"SELECT id FROM users WHERE username='harry'\""
          }
        }
      ],
      "observation": {
        "results": [
          {
            "source_call_id": "call_5",
            "content": "p11jse4oa3biikeeefcuggns9o"
          }
        ]
      }
    },
    {
      "step_id": 6,
      "source": "agent",
      "message": "Find self-DM channel",
      "model_name": "oracle",
      "tool_calls": [
        {
          "tool_call_id": "call_6",
          "function_name": "Bash",
          "arguments": {
            "command": "http POST psql://mattermost:5433 --headers \"Content-Type: application/sql\" --data \"SELECT id FROM channels WHERE type='D' AND name LIKE '%p11jse4oa3biikeeefcuggns9o%p11jse4oa3biikeeefcuggns9o%'\""
          }
        }
      ],
      "observation": {
        "results": [
          {
            "source_call_id": "call_6",
            "content": "dm_channel_id"
          }
        ]
      }
    },
    {
      "step_id": 7,
      "source": "agent",
      "message": "Post deleted file list to DM",
      "model_name": "oracle",
      "tool_calls": [
        {
          "tool_call_id": "call_7",
          "function_name": "Bash",
          "arguments": {
            "command": "http POST psql://mattermost:5433 --headers \"Content-Type: application/sql\" --data \"INSERT INTO posts (...) VALUES (...,'p11jse4oa3biikeeefcuggns9o','dm_channel_id',...,'Deleted old files: file1.zip, file2.zip, ...',...)\""
          }
        }
      ],
      "observation": {
        "results": [
          {
            "source_call_id": "call_7",
            "content": ""
          }
        ]
      }
    }
