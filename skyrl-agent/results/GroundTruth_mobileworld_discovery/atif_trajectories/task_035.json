          "tool_call_id": "call_5",
          "function_name": "Bash",
          "arguments": {
            "command": "sql /data/data/org.joinmastodon.android.mastodon/databases/accounts.db \"SELECT id,token FROM accounts\""
          }
        }
      ],
      "observation": {
        "results": [
          {
