#!/usr/bin/env python3
"""find-files shim — forwards to `python $ANDROID_ENV_SCRIPT find-files`."""
import os
import subprocess
import sys


def main() -> int:
    script = os.environ.get("ANDROID_ENV_SCRIPT")
    if not script:
        print("ERROR: ANDROID_ENV_SCRIPT env var not set", file=sys.stderr)
        return 1
    return subprocess.call(
        [sys.executable, script, "find-files", *sys.argv[1:]]
    )


if __name__ == "__main__":
    sys.exit(main())
